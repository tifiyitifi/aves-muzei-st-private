# Keep the git hooks and the build number file LF on every platform,
# so the pre-commit hook works the same on Windows and Unix.
.githooks/* text eol=lf
android/version.properties text eol=lf
# POSIX shell scripts are executed by the git hooks and CI; a CRLF checkout
# would corrupt them on Windows.
scripts/*.sh text eol=lf
# The AI scratch-space helper is a POSIX shell script too.
.ai_tmp/_common/*.sh text eol=lf
