#!/bin/sh
# Two local gates on the exact commits about to leave this machine:
#
# - privacy: no real local path or private term (backstop for --no-verify).
# - docs: the feature index covers every slice, and a register the change touched
#   still resolves. CI has no dev-branch trigger, so this is the only guard.
#
# Both stay fail-open when PowerShell is missing; each says so on stderr.

status=0
while read local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac
  case "$remote_sha" in
    *[!0]*)
      range="$remote_sha..$local_sha"
      sh scripts/run-local-privacy-gate.sh -Pushed -Range "$range" || status=1
      sh scripts/run-feature-doc-gate.sh -Range "$range" || status=1
      ;;
    *)
      sh scripts/run-local-privacy-gate.sh -Pushed || status=1
      sh scripts/run-feature-doc-gate.sh || status=1
      ;;
  esac
done
exit $status
